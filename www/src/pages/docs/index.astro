---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { docsNav } from '../../lib/docs-nav';

const frontmatter = {
  title: 'Documentation',
  description:
    'Everything you need to install, configure and run Gitea Mirror: quickstart, deployment, configuration, notifications, authentication and more.',
};

const sectionBlurbs: Record<string, string> = {
  'Getting Started': 'Install Gitea Mirror, create the tokens it needs, and get your first mirror running.',
  'Using It': 'Connect sources and a destination, choose what gets mirrored, and keep it tidy.',
  'Operating': 'Sign-in, reverse proxies, backups, upgrades, and fixes for common problems.',
  'Reference': 'Every environment variable, the REST API, the MCP server, and how it all fits together.',
};
---

<DocsLayout frontmatter={frontmatter}>
  <h1>Gitea Mirror Documentation</h1>
  <p>
    Gitea Mirror is a self-hosted service that keeps copies of your repositories
    from GitHub, GitLab, Gitea, Forgejo or any git host on your own Gitea or
    Forgejo server: code, releases, issues, wikis and more. These docs cover
    installation, configuration and every feature in the app.
  </p>

  {docsNav.map((section) => (
    <section>
      <h2>{section.title}</h2>
      <p>{sectionBlurbs[section.title]}</p>
      <ul>
        {section.items.map((item) => (
          <li>
            <a href={item.href}>{item.title}</a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <h2>Offline reference</h2>
  <p>
    Running air-gapped? These pages are written in MDX and live in the
    repository under
    <a
      href="https://github.com/RayLabsHQ/gitea-mirror/tree/main/www/src/pages/docs"
      target="_blank"
      rel="noopener noreferrer"
    >
      www/src/pages/docs
    </a>
    , so a checkout of the release you installed carries the matching version.
  </p>
</DocsLayout>
